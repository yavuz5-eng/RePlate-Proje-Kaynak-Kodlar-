  TRSonucG     : String;
  RestG        : TclRest;
  FB_URL_G     : String;
  SayacUser    : Integer;
  AktifRol     : String;
  AktifAd      : String;
  AktifKullaniciAdi : String;

  // --- KAYIT EKRANI İÇİN YENİ DEĞİŞKENLER ---
  PnlKayit       : TclProPanel;
  LblBaslikK     : TclProLabel;
  LblKAd         : TclProLabel;
  EdtKAd         : TclProEdit;
  LblKEposta     : TclProLabel;
  EdtKEposta     : TclProEdit;
  LblKSifre      : TclProLabel;
  EdtKSifre      : TclProEdit;
  LblKRol        : TclProLabel;
  PnlRolWrapper  : TclProPanel;
