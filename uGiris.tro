  LblZatenVar    : TclProLabel;
  LblHataK       : TclProLabel;
  SayacYeniKayit : Integer;

void TRDegistirG(AKod : String; AHarf : String);
{
  while (Pos(AKod, TRSonucG) > 0)
  {
    TRSonucG = Copy(TRSonucG, 1, Pos(AKod, TRSonucG) - 1) + AHarf + Copy(TRSonucG, Pos(AKod, TRSonucG) + 2, 100000);
  }
}

void TRG(AMetin : String);
{
  TRSonucG = AMetin;
  TRDegistirG('g%', Chr(287));
  TRDegistirG('G%', Chr(286));
  TRDegistirG('s%', Chr(351));
  TRDegistirG('S%', Chr(350));
  TRDegistirG('i%', Chr(305));
  TRDegistirG('I%', Chr(304));
}

// ---- YENİ: Clomosy Dahili SQLite Nesnesi ile Hazırlık ----
void SQLiteHazirla;
{
  try
    Clomosy.DBSQLiteConnect(Clomosy.AppBasePath + 'replate.db', '');
    Clomosy.DBSQLiteQuery.SQL.Text = 'CREATE TABLE IF NOT EXISTS TBLHATIRLA (Eposta TEXT, Sifre TEXT)';
    Clomosy.DBSQLiteQuery.OpenOrExecute; 
  except
    ShowMessage('Veritabani% bag%lanti% hatasi%: ' + LastExceptionMessage);
  }
}

// ---- Beni Hatirla ----

void HatirlaCaptionGuncelle;
{
  TRG('Beni Hati%rla');
  if (HatirlaAcik)
    LblHatirla.Text = '[X]  ' + TRSonucG;
  else
    LblHatirla.Text = '[  ]  ' + TRSonucG;
}

void HatirlaToggle;
{
  HatirlaAcik = not HatirlaAcik;
  HatirlaCaptionGuncelle;
}

void HatirlaKaydet(AEposta : String; ASifre : String);
{
  try
    Clomosy.DBSQLiteQuery.SQL.Text = 'DELETE FROM TBLHATIRLA';
    Clomosy.DBSQLiteQuery.OpenOrExecute; 

    if (HatirlaAcik)
    {
      Clomosy.DBSQLiteQuery.SQL.Text = 'INSERT INTO TBLHATIRLA (Eposta, Sifre) VALUES (''' + AEposta + ''', ''' + ASifre + ''')';
      Clomosy.DBSQLiteQuery.OpenOrExecute; 
    }
  except
  }
}

void HatirlaYukle;
{
  try
    Clomosy.DBSQLiteQuery.SQL.Text = 'SELECT * FROM TBLHATIRLA';
    Clomosy.DBSQLiteQuery.OpenOrExecute;
    
    if (Clomosy.DBSQLiteQuery.Found)
    {
      EdtKullanici.Text = Clomosy.DBSQLiteQuery.FieldByName('Eposta').AsString;
      EdtSifre.Text = Clomosy.DBSQLiteQuery.FieldByName('Sifre').AsString;
      HatirlaAcik = True;
    }
    else
    {
      if (EdtKullanici.Text <> 'ornek@mail.com')
      {
         EdtKullanici.Text = '';
         EdtSifre.Text = '';
      }
      HatirlaAcik = False;
    }
  except
  }
  
  HatirlaCaptionGuncelle;
}

// ---- EKRANLAR ARASI GEÇİŞ ----

void KayitModunaGec;
{
  PnlGiris.Visible = False;
  PnlKayit.Visible = True;
  
  EdtKAd.Text = '';
  EdtKEposta.Text = '';
  EdtKSifre.Text = '';
  LblHataK.Visible = False;
}

void GirisModunaGec;
{
  PnlKayit.Visible = False;
  PnlGiris.Visible = True;
}

// ---- Ana sayfa yonlendirme handler'lari ----

void KaydetBasildi;
{
  uUrunEkle.KaydetTiklandi;
}

void EkleTiklandi;
{
  uUrunEkle.AcUrunEkleFormu;
  uUrunEkle.BtnKaydet.OnClick = 'KaydetBasildi';
}

void UrunlerTiklandi;
{
  uUrunListesi.AcListeFormu;
  uUrunListesi.BtnEkle.OnClick = 'EkleTiklandi';
}

void IlanlarTiklandi;
{
  uIlanlar.AcIlanlarFormu;
}

void MarketRezTiklandi;
{
  uMarketRezervasyon.AcMarketRezervasyonFormu;
}

// ---- YENİ KAYIT AKIŞI (FIREBASE) ----

void KayitTamamlandi;
{
  RestG.Free; 
  RestG = Nil;
  
  ShowMessage('Kayıt başarıyla oluşturuldu! Lütfen giriş yapın.');
  
  PnlKayit.Visible = False;
  PnlGiris.Visible = True;
  EdtKullanici.Text = EdtKEposta.Text;
  EdtSifre.Text = '';
}

void YeniKullaniciEklendi;
{
  RestG.Free; 
  RestG = Nil;

  RestG = TclRest.Create;
  RestG.Accept = 'application/json';
  RestG.ContentType = 'application/json';
  RestG.BaseURL = FB_URL_G + 'SAYACUSER.json';
  RestG.Method = rmPUT;
  RestG.Body = IntToStr(SayacYeniKayit);
  RestG.OnCompleted = 'KayitTamamlandi';
  RestG.ExecuteAsync;
}

void YeniKayitSayacGeldi;
var
  JBody, Q : String;
{
  if (RestG.Response == 'null') 
  {
    SayacYeniKayit = 0;
  }
  else 
  {
    SayacYeniKayit = StrToInt(RestG.Response);
  }

  RestG.Free; 
  RestG = Nil;

  SayacYeniKayit = SayacYeniKayit + 1;

  Q = Chr(34);
  JBody = '{';
  JBody = JBody + Q + 'gorunenAd' + Q + ':' + Q + EdtKAd.Text + Q + ',';
  JBody = JBody + Q + 'kullaniciAdi' + Q + ':' + Q + EdtKEposta.Text + Q + ',';
  JBody = JBody + Q + 'sifre' + Q + ':' + Q + EdtKSifre.Text + Q + ',';
  
  if (CmbKRol.ItemIndex == 0) 
  {
    JBody = JBody + Q + 'rol' + Q + ':' + Q + 'market' + Q;
  }
  else 
  {
    JBody = JBody + Q + 'rol' + Q + ':' + Q + 'stk' + Q;
  }
  JBody = JBody + '}';

  RestG = TclRest.Create;
  RestG.Accept = 'application/json';
  RestG.ContentType = 'application/json';
  RestG.BaseURL = FB_URL_G + 'USERS/' + IntToStr(SayacYeniKayit) + '.json';
  RestG.Method = rmPUT;
  RestG.Body = JBody;
  RestG.OnCompleted = 'YeniKullaniciEklendi';
  RestG.ExecuteAsync;
}

void BtnYeniKayitTiklandi;
{
  if ((EdtKAd.Text == '') || (EdtKEposta.Text == '') || (EdtKSifre.Text == '') || (CmbKRol.ItemIndex == -1))
  {
    TRG('Tüm alanlari% doldurun veya rol sec%in');
    LblHataK.Text = TRSonucG;
    LblHataK.Visible = True;
  }
  else
  {
    LblHataK.Visible = False;
    
    RestG = TclRest.Create;
    RestG.Accept = 'application/json';
    RestG.ContentType = 'application/json';
    RestG.ConnectTimeOut = 60000;
    RestG.BaseURL = FB_URL_G + 'SAYACUSER.json';
    RestG.Method = rmGet;
    RestG.OnCompleted = 'YeniKayitSayacGeldi';
    RestG.ExecuteAsync;
  }
}

// ---- Giris akisi ----

void GirisiTamamla;
{
  HatirlaKaydet(EdtKullanici.Text, EdtSifre.Text);   

  if (AktifRol == 'market')
  {
    uUrunListesi.G_MarketAd = AktifAd; 
    uAnaSayfa.G_MarketAdA = AktifAd; 
    
    uAnaSayfa.AcAnaSayfa;
    
    uAnaSayfa.BtnUrunler.OnClick = 'UrunlerTiklandi';
    uAnaSayfa.BtnYeniUrun.OnClick = 'EkleTiklandi';
    
    uMarketRezervasyon.G_AktifAd = AktifAd;
    uAnaSayfa.BtnIlanlar.OnClick = 'MarketRezTiklandi';
    
    uAnaSayfa.LblCikis.OnClick = 'CikisTiklandi';

    TRG('Hos% geldiniz, ' + AktifAd);
    uAnaSayfa.LblKullanici.Text = TRSonucG;
  }
  else
  {
    uNgoAna.G_NgoAdA = AktifAd;
    
    uNgoAna.AcNgoAnaSayfa;
    uNgoAna.LblCikisN.OnClick = 'CikisTiklandi';
    
    TRG('Hos% geldiniz, ' + AktifAd);
    uNgoAna.LblKullaniciN.Text = TRSonucG;
  }

  uIlanlar.G_AktifRol = AktifRol;
  uIlanlar.G_AktifAd = AktifAd;
  uIlanlar.G_AktifKullaniciAdi = AktifKullaniciAdi;
  
  uNgoRezervasyon.G_AktifAd = AktifAd;

  // Çıkış yapılıp form kapandığında burası tetiklenerek değerleri günceller
  HatirlaYukle; 
}

void GUsersGeldi;
var
  k : Integer;
  KAdi : String;
  KSifre : String;
  Bulundu : Boolean;
  Cevap : String;
{
  Cevap = RestG.Response;

  RestG.Free;
  RestG = Nil;

  Bulundu = False;

  for k = 3001 to SayacUser
  {
    if (Pos('"' + IntToStr(k) + '"', Cevap) > 0)
    {
      KAdi = Clomosy.CLParseJSON(Cevap, IntToStr(k) + '.kullaniciAdi');
      KSifre = Clomosy.CLParseJSON(Cevap, IntToStr(k) + '.sifre');

      if ((KAdi == EdtKullanici.Text) && (KSifre == EdtSifre.Text))
      {
        Bulundu = True;
        AktifRol = Clomosy.CLParseJSON(Cevap, IntToStr(k) + '.rol');
        AktifAd = Clomosy.CLParseJSON(Cevap, IntToStr(k) + '.gorunenAd');
        AktifKullaniciAdi = Clomosy.CLParseJSON(Cevap, IntToStr(k) + '.kullaniciAdi');
      }
    }
  }

  if (Bulundu)
  {
    LblHataG.Visible = False;
    GirisiTamamla;
  }
  else
  {
    TRG('E-posta veya s%ifre hatali%');
    LblHataG.Text = TRSonucG;
    LblHataG.Visible = True;
  }
}

void GSayacGeldi;
{
  if (RestG.Response == 'null')
  {
    SayacUser = 0;
  }
  else
  {
    SayacUser = StrToInt(RestG.Response);
  }

  RestG.Free;
  RestG = Nil;

  if (SayacUser > 0)
  {
    RestG = TclRest.Create;
    RestG.Accept = 'application/json';
    RestG.ContentType = 'application/json';
    RestG.ConnectTimeOut = 60000;
    RestG.BaseURL = FB_URL_G + 'USERS.json';
    RestG.Method = rmGet;
    RestG.OnCompleted = 'GUsersGeldi';
    RestG.ExecuteAsync;
  }
  else
  {
    TRG('Kullani%ci% kaydi% bulunamadi%');
    LblHataG.Text = TRSonucG;
    LblHataG.Visible = True;
  }
}

void GirisTiklandi;
{
  if ((EdtKullanici.Text == '') || (EdtSifre.Text == ''))
  {
    TRG('Tüm alanlari% doldurun');
    LblHataG.Text = TRSonucG;
    LblHataG.Visible = True;
  }
  else
  {
    try
      RestG = TclRest.Create;
      RestG.Accept = 'application/json';
      RestG.ContentType = 'application/json';
      RestG.ConnectTimeOut = 60000;
      RestG.BaseURL = FB_URL_G + 'SAYACUSER.json';
      RestG.Method = rmGet;
      RestG.OnCompleted = 'GSayacGeldi';
      RestG.ExecuteAsync;
    except
      ShowMessage('Hata: ' + LastExceptionMessage);
    }
  }
}

void VirtualKeyboardShow;
{
  MainScrollBox.Margins.Bottom = GirisForm.clVKBoundsHeight;
}

void VirtualKeyboardHidden;
{
  MainScrollBox.Margins.Bottom = 0;
}

void AcGirisFormu;
{
