  PnlGiris     : TclProPanel;
  LblHosgeldin : TclProLabel;
  LblBaslikG   : TclProLabel;
  LblEposta    : TclProLabel;
  EdtKullanici : TclProEdit;
  LblSifreG    : TclProLabel;
  EdtSifre     : TclProEdit;
  BtnGiris     : TclProButton;
  LblKayit     : TclProLabel;
  LblHataG     : TclProLabel;
  LblHatirla   : TclProLabel;   
