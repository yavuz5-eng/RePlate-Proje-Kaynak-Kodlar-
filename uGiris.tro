  PnlGiris.Height = 500; 
  PnlGiris.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#1E293B');
  PnlGiris.clProSettings.BorderColor = clAlphaColor.clHexToColor('#334155');
  PnlGiris.clProSettings.BorderWidth = 1;
  PnlGiris.clProSettings.RoundHeight = 18;
  PnlGiris.clProSettings.RoundWidth = 18;
  PnlGiris.SetclProSettings(PnlGiris.clProSettings);

  TRG('TEKRAR HOS% GELDI%NI%Z');
