  // ACİL İLANLAR BUTONU
  TR('Acil I%lanlari% Göster'); 
  BtnAcil = ListeForm.AddNewProButton(ListeForm, 'BtnAcil', TRSonuc);
  BtnAcil.Align = alTop; BtnAcil.Height = 35; BtnAcil.Margins.Top = 8; BtnAcil.Margins.Left = 20; BtnAcil.Margins.Right = 20;
  BtnAcil.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#EF4444');
  BtnAcil.clProSettings.FontColor = clAlphaColor.clWhite;
  BtnAcil.clProSettings.RoundHeight = 8; BtnAcil.clProSettings.RoundWidth = 8; BtnAcil.clProSettings.BorderWidth = 0;
  BtnAcil.clProSettings.TextSettings.Font.Style = [fsBold];
  BtnAcil.SetclProSettings(BtnAcil.clProSettings);
  ListeForm.AddNewEvent(BtnAcil, tbeOnClick, 'AcilDurumDegistir');

  PnlFiltreWrapper = ListeForm.AddNewProPanel(ListeForm, 'PnlFiltreWrapper');
  PnlFiltreWrapper.Align = alTop; PnlFiltreWrapper.Height = 44; PnlFiltreWrapper.Margins.Top = 8; PnlFiltreWrapper.Margins.Left = 20; PnlFiltreWrapper.Margins.Right = 20; PnlFiltreWrapper.Margins.Bottom = 0;
  PnlFiltreWrapper.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#E5E7EB');
  PnlFiltreWrapper.clProSettings.BorderColor = clAlphaColor.clHexToColor('#4B5563'); PnlFiltreWrapper.clProSettings.BorderWidth = 1;
  PnlFiltreWrapper.clProSettings.RoundHeight = 8; PnlFiltreWrapper.clProSettings.RoundWidth = 8;
  PnlFiltreWrapper.SetclProSettings(PnlFiltreWrapper.clProSettings);

  CmbFiltre = ListeForm.AddNewComboBox(PnlFiltreWrapper, 'CmbFiltre');
