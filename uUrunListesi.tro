  BtnAra.clProSettings.RoundHeight = 5; BtnAra.clProSettings.RoundWidth = 5; BtnAra.clProSettings.TextSettings.Font.Style = [fsBold];
  BtnAra.SetclProSettings(BtnAra.clProSettings);
  ListeForm.AddNewEvent(BtnAra, tbeOnClick, 'AramaTetikle');

  YenilemeNo = 0;
  ListeyiYenile;
  ListeForm.Run;
}