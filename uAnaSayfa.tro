  LblKullanici.clProSettings.FontSize = 13;
  LblKullanici.clProSettings.FontColor = clAlphaColor.clHexToColor('#7C7CF0');
  LblKullanici.clProSettings.FontHorzAlign = palCenter;
  LblKullanici.SetclProSettings(LblKullanici.clProSettings);

  PnlOzet = AnaForm.AddNewProPanel(AnaForm, 'PnlOzet');
  PnlOzet.Align = alTop; PnlOzet.Height = 60; PnlOzet.Margins.Top = 20; PnlOzet.Margins.Left = 30; PnlOzet.Margins.Right = 30;
  PnlOzet.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#1F2937');
  PnlOzet.clProSettings.BorderColor = clAlphaColor.clHexToColor('#374151');
