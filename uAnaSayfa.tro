  LblLogo.clProSettings.FontHorzAlign = palCenter;
  LblLogo.clProSettings.TextSettings.Font.Style = [fsBold];
  LblLogo.SetclProSettings(LblLogo.clProSettings);

  TRA('Tarihi yaklas%an ürünler i%srafa deg%i%l, deg%ere dönüs%sün');
  LblSlogan = AnaForm.AddNewProLabel(AnaForm, 'LblSlogan', TRSonucA);
  LblSlogan.Align = alTop; LblSlogan.Height = 40; LblSlogan.Margins.Top = 5; LblSlogan.Margins.Left = 20; LblSlogan.Margins.Right = 20;
  LblSlogan.clProSettings.FontSize = 13;
  LblSlogan.clProSettings.FontColor = clAlphaColor.clHexToColor('#9CA3AF');
  LblSlogan.clProSettings.FontHorzAlign = palCenter;
  LblSlogan.SetclProSettings(LblSlogan.clProSettings);

