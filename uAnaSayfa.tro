uses uProfil, uMarketGecmis; 

var
  AnaForm      : TclForm;
  LblLogo      : TclProLabel;
  LblSlogan    : TclProLabel;
  LblKullanici : TclProLabel;
  LblCikis     : TclProLabel; 
  PnlUst       : TclProPanel; 
  ImgProfil    : TclImage;    
  PnlOzet      : TclProPanel;
  LblOzet      : TclProLabel;
  BtnUrunler   : TclProButton;
  BtnYeniUrun  : TclProButton;
  BtnIlanlar   : TclProButton;
  BtnGecmis    : TclProButton; 
  LblAltBilgi  : TclProLabel;
  TRSonucA     : String;
  RestA        : TclRest;
  FB_URL_A     : String;
  SayacA       : Integer;
  G_MarketAdA  : String;

void TRDegistirA(AKod : String; AHarf : String);
{
  while (Pos(AKod, TRSonucA) > 0)
  {
    TRSonucA = Copy(TRSonucA, 1, Pos(AKod, TRSonucA) - 1) + AHarf + Copy(TRSonucA, Pos(AKod, TRSonucA) + 2, 100000);
  }
}

void TRA(AMetin : String);
{
  TRSonucA = AMetin;
  TRDegistirA('c%', Chr(231)); 
  TRDegistirA('C%', Chr(199)); 
  TRDegistirA('g%', Chr(287));
  TRDegistirA('G%', Chr(286));
  TRDegistirA('s%', Chr(351));
  TRDegistirA('S%', Chr(350));
  TRDegistirA('i%', Chr(305)); 
  TRDegistirA('I%', Chr(304)); 
  TRDegistirA('u%', Chr(252)); 
  TRDegistirA('U%', Chr(220)); 
  TRDegistirA('o%', Chr(246)); 
  TRDegistirA('O%', Chr(214)); 
}

void CikisTiklandi;
{
  try
    Clomosy.DBSQLiteQuery.Sql.Text = 'DELETE FROM TBLHATIRLA';
    Clomosy.DBSQLiteQuery.OpenOrExecute;
  except
  }
  
  if (uProfil.ProfilForm <> nil)
  {
    uProfil.ProfilForm.Close;
  }
  
  if (AnaForm <> nil)
  {
    AnaForm.Close;
  }
}

void ProfilTiklandi;
{
  uProfil.P_AktifAd = G_MarketAdA; 
  uProfil.P_AktifRol = 'market';   
  
  uProfil.AcProfilFormu;
  
  uProfil.BtnCikis.OnClick = 'CikisTiklandi'; 
}

void GecmisTiklandi;
{
  uMarketGecmis.G_AktifAd = G_MarketAdA; 
  uMarketGecmis.AcMarketGecmisFormu;
}

void OzetHesapla(AJson : String);
var
  k : Integer;
  KalanGun : Integer;
  SktStr : String;
  UrunAd : String;
  Toplam : Integer;
  Kritik : Integer;
  Gecmis : Integer;
  UrunMarketAd : String; 
{
  try
    Toplam = 0;
    Kritik = 0;
    Gecmis = 0;

    for k = 1001 to SayacA
    {
      if (Pos('"' + IntToStr(k) + '"', AJson) > 0)
      {
        UrunAd = Clomosy.CLParseJSON(AJson, IntToStr(k) + '.ad');
        SktStr = Clomosy.CLParseJSON(AJson, IntToStr(k) + '.skt');

        try
          UrunMarketAd = Clomosy.CLParseJSON(AJson, IntToStr(k) + '.marketAd');
        except
          UrunMarketAd = ''; 
        }

        if ((UrunAd <> '') && (SktStr <> '') && (UrunMarketAd == G_MarketAdA))
        {
          KalanGun = Trunc(EncodeDate(StrToInt(Copy(SktStr, 1, 4)), StrToInt(Copy(SktStr, 6, 2)), StrToInt(Copy(SktStr, 9, 2))) - Date);

          Toplam = Toplam + 1;
          if (KalanGun < 0)
          {
            Gecmis = Gecmis + 1;
          }
          else
          {
            if (KalanGun < 3)
            {
              Kritik = Kritik + 1;
            }
          }
        }
      }
    }

    TRA(IntToStr(Toplam) + ' ürün  |  ' + IntToStr(Kritik) + ' kritik  |  ' + IntToStr(Gecmis) + ' SKT geçmis%');
    LblOzet.Text = TRSonucA;
  except
    LblOzet.Text = 'Özet yüklenemedi';
  }
}

void FbUrunlerGeldiA;
{
  OzetHesapla(RestA.Response);

  RestA.Free;
  RestA = Nil;
}

void FbSayacGeldiA;
{
  if (RestA.Response == 'null')
  {
    SayacA = 0;
  }
  else
  {
    SayacA = StrToInt(RestA.Response);
  }

  RestA.Free;
  RestA = Nil;

  if (SayacA > 0)
  {
    RestA = TclRest.Create;
    RestA.Accept = 'application/json';
    RestA.ContentType = 'application/json';
    RestA.ConnectTimeOut = 60000;
    RestA.BaseURL = FB_URL_A + 'TBLPRODUCTS.json';
    RestA.Method = rmGet;
    RestA.OnCompleted = 'FbUrunlerGeldiA';
    RestA.ExecuteAsync;
  }
  else
  {
    TRA('0 ürün  |  0 kritik  |  0 SKT geçmis%');
    LblOzet.Text = TRSonucA;
  }
}

void OzetiYenile;
{
  try
    RestA = TclRest.Create;
    RestA.Accept = 'application/json';
    RestA.ContentType = 'application/json';
    RestA.ConnectTimeOut = 60000;
    RestA.BaseURL = FB_URL_A + 'SAYAC.json';
    RestA.Method = rmGet;
    RestA.OnCompleted = 'FbSayacGeldiA';
    RestA.ExecuteAsync;
  except
    LblOzet.Text = 'Özet yüklenemedi';
  }
}

