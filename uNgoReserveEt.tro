  LblOnaySoru.clProSettings.FontColor = clAlphaColor.clHexToColor('#9CA3AF');
  LblOnaySoru.clProSettings.FontHorzAlign = palCenter;
  LblOnaySoru.SetclProSettings(LblOnaySoru.clProSettings);

  // YENİ: Limit bilgi satiri
  LblLimitBilgi = OnayForm.AddNewProLabel(PnlOnayMerkez, 'LblLimitBilgi', 'Limit bilgisi yukleniyor...');
  LblLimitBilgi.Align = alTop; LblLimitBilgi.Height = 22; LblLimitBilgi.Margins.Top = 4; LblLimitBilgi.Margins.Left = 10; LblLimitBilgi.Margins.Right = 10;
  LblLimitBilgi.clProSettings.FontColor = clAlphaColor.clHexToColor('#FBBF24');
  LblLimitBilgi.clProSettings.FontHorzAlign = palCenter;
  LblLimitBilgi.clProSettings.FontSize = 12;
  LblLimitBilgi.clProSettings.TextSettings.Font.Style = [fsBold];
  LblLimitBilgi.SetclProSettings(LblLimitBilgi.clProSettings);

  EdtMiktarOnay = OnayForm.AddNewProEdit(PnlOnayMerkez, 'EdtMiktarOnay', '1');
  EdtMiktarOnay.Align = alTop; EdtMiktarOnay.Height = 45; EdtMiktarOnay.Margins.Top = 12; EdtMiktarOnay.Margins.Left = 30; EdtMiktarOnay.Margins.Right = 30;
  EdtMiktarOnay.clProSettings.BackgroundColor = clAlphaColor.clHexToColor('#0F172A');
  EdtMiktarOnay.clProSettings.FontColor = clAlphaColor.clHexToColor('#F8FAFC');
  EdtMiktarOnay.clProSettings.BorderColor = clAlphaColor.clHexToColor('#4B5563');
